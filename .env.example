# Copy to .env before running docker compose.
# Throw-away local Docker credentials only.

MYSQL_ROOT_PASSWORD=root_local_pw

# Host port for the master container. Change if 3306 is already in use.
MYSQL_MASTER_PORT=3306

# Tenant credentials. Keep these in sync with seeds/master_tenants.sql.
PIZZA_DB_USER=pizza_palace_user
PIZZA_DB_PASSWORD=pizza_local_pw
SUSHI_DB_USER=sushi_house_user
SUSHI_DB_PASSWORD=sushi_local_pw
